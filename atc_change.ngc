; atc_change.ngc - Carousel automatic tool change
;
; Called by flexihal_atc.c tool_change() when the requested tool is in
; the carousel.  Named parameters are set by the plugin before this macro
; is started:
;
;   #<_t>                    = incoming tool number
;   #<_p>                    = incoming carousel pocket number
;   #<_atc_outgoing_pocket>  = outgoing tool pocket (0 = was hand-loaded)
;
; On completion, $TCMEASURE probes the new tool against G59.3.
;
; Adjust pocket XY geometry constants to match your carousel layout.

M5    ; ensure spindle is off
M9    ; ensure coolant is off

; ── Calculate incoming pocket XY ─────────────────────────────────────────────
; Example: linear carousel along X, pocket 1 at X=50, 40mm pitch.
; Replace with your actual carousel geometry.
#100 = [50.0 + [#<_p> - 1] * 40.0]   ; pocket X
#101 = 200.0                            ; pocket Y (fixed for linear carousel)

; ── Retract to safe Z ────────────────────────────────────────────────────────
G53 G0 Z#<_home_z>

; ── Return outgoing tool if it came from the carousel ────────────────────────
o100 if [#<_atc_outgoing_pocket> GT 0]
  #102 = [50.0 + [#<_atc_outgoing_pocket> - 1] * 40.0]  ; outgoing pocket X
  G53 G0 X#102 Y#101
  G53 G0 Z#<_atc_z_start>
  G53 G1 Z#<_atc_z_engage> F#<_atc_feed>
  $DRBO
  G4 P0.5
  G53 G0 Z#<_home_z>
o100 endif

; ── Pick up incoming tool ─────────────────────────────────────────────────────
G53 G0 X#100 Y#101
G53 G0 Z#<_atc_z_start>
G53 G1 Z#<_atc_z_engage> F#<_atc_feed>
$DRBC
G4 P0.5
G53 G0 Z#<_home_z>

; ── Measure new tool length against G59.3 toolsetter ─────────────────────────
$TCMEASURE

M2
