; ATC_MACRO_ID_HANDRETURN   393 //manual tool return (raise Z, go to G30, pause for operator to remove tool)
;
; Called when the outgoing tool needs to be removed by hand (no pocket entry).
; Pauses for the operator to remove the outgoing hand-loaded tool.
;
; Parameters:
;   #4900 = outgoing tool number
;   #4908 = 1 if called as part of a combined hand→hand swap (skip M0, P392 handles single pause)

; ── Move to manual change position (G30) ─────────────────────────────────────
G53 G0 Z0
G53 G0 X#5181                               ; G30 X only — Y unchanged

; ── Notify operator ───────────────────────────────────────────────────────────
o100 if [#4908 EQ 1]
  #4908 = 0
  (print, ATC: remove T#4900 and install T#4902 then press cycle start)
o100 else
  (print, ATC: remove tool #4900 and press cycle start)
  M0
o100 endif

M99
