; ATC_MACRO_ID_TCRETURN  391 //return to tool carousel (OpenPnP four-positions style)
;
; Parameters:
;   #4900 = tool number
;   #4901 = carousel pocket number
;   #4905 = 1: fire M61 Q0 at end (called from $TCADD/$TCRETURN), 0: skip
;   #4906 = 0: open carousel, rotate, close (return only)
;           1: open carousel, rotate, leave open (return in a fetch+return pair)
;
; Geometry parameters — set once by G65 P200 in your startup macro:
;
;   #4920-#4922  Position 1: Safe XYZ
;   #4923-#4925  Position 2: Approach XYZ
;   #4926-#4928  Position 3: Engage XYZ
;   #4929-#4931  Position 4: Exit XYZ
;   #4932        Feed rate for all carousel positioning moves (mm/min)
;
; Unload sequence:  P1 → P2 → P3 [open drawbar] → P4 [close drawbar]

; ── Move to safe position (P1) ───────────────────────────────────────────────
G53 G0 Z#4922
G53 G0 X#4920

; ── Open carousel ────────────────────────────────────────────────────────────
G65 P201
G65 P7 S3 F16 R1 A99

; ── Carousel positioning — rotate to outgoing pocket ─────────────────────────
; [ADD CAROUSEL ROTATION TO POCKET #4901 HERE]
G65 P201
G65 P7 S3 F16 R1 A[100 + #4901]
G65 P201

; ── Approach outgoing pocket (P2) ────────────────────────────────────────────
G53 G1 X#4923 F#4932
G53 G1 Z#4925 F#4932

; ── Engage outgoing pocket (P3) — deposit tool, open drawbar ─────────────────
G53 G1 X#4926 Z#4928 F#4932
G4 P0
$DRBO
G4 P0

; ── Exit outgoing pocket (P4) ────────────────────────────────────────────────
G53 G1 X#4929 Z#4931 F#4932
G4 P0
$DRBC
G4 P0

; ── Withdraw to safe position (P1) ───────────────────────────────────────────
G53 G0 X#4920 Z#4922

; ── Close carousel (only if not leaving open for subsequent fetch) ────────────
o110 if [#4906 EQ 0]
  G4 P0
  G65 P7 S3 F16 R1 A98
o110 endif

; ── Optionally update current tool to T0 ─────────────────────────────────────
o200 if [#4905 EQ 1]
  #4905 = 0
  M61 Q0
o200 endif

M99
