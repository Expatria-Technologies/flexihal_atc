; ATC_MACRO_ID_MEASURE      394 //probe tool length against G59.3 toolsetter
;
; Part of the flexiHAL ATC plugin.  Called by tc.macro after a tool is
; physically clamped in the spindle, or directly by $TCMEASURE.
;
; PREREQUISITES
;   - Machine fully homed (XYZ)
;   - Spindle stopped, coolant off
;   - Tool clamped in spindle
;   - G65 P200 run at startup to set geometry and probe parameters
;
; PARAMETERS (set by G65 P200)
;   #4933  probing distance (mm)      max downward travel toward toolsetter
;   #4934  locate feed rate (mm/min)  slow, accurate second probe
;   #4935  seek feed rate (mm/min)    fast first probe
;   #4936  pulloff distance (mm)      retract between fast and slow probes
;
; COORDINATE SYSTEM
;   G59.3 must be configured with:
;     X, Y  —  toolsetter centre (machine coordinates)
;     Z     —  approach height: top of toolsetter body + small air gap
;               (machine coordinate, i.e. a negative number on typical machines)
;   Parameters used: #5381 (G59.3 X), #5382 (G59.3 Y), #5383 (G59.3 Z)
;
; TOOL LENGTH OFFSET
;   Uses G10 L1 to store the measured length in the tool table.
;
;   G49 is issued before probing to cancel any active TLO so that the probe
;   result is a raw machine coordinate unaffected by a previous tool's offset.
;
;   After storing, G43 H#5400 reloads the offset for the current tool from
;   the table and activates it.  Subsequent motion is now compensated.
;
; SKIPPING ALREADY-PROBED TOOLS
;   If the tool table already contains a non-zero Z offset for the current
;   tool, the probe sequence is skipped and the stored offset is activated
;   directly via G43 H#5400.
;
; PROBE SEQUENCE
;   1.  Validate current tool number — abort if T0
;   2.  Read stored Z offset — skip to step 9 if non-zero (already measured)
;   3.  Cancel active TLO (G49)
;   4.  Rapid Z to home (G53 Z0)
;   5.  Rapid XY to G59.3 toolsetter position
;   6.  Rapid Z to G59.3 approach height
;   7.  Fast seek probe downward — G38.3 (no-error variant) at #4935
;   8.  Abort if toolsetter not triggered (#5070)
;   9.  Retract #4936 mm
;   10. Slow locate probe — G38.4 (probe away, error on loss of contact) at #4934
;   11. Store gauge length: G10 L11 P#5400 Z0
;   12. Activate offset: G43 H#5400
;   13. Rapid Z to home

; ── 1b. Validate machine is homed ────────────────────────────────────────────
o105 if [#<_homed_state> EQ 0]
  (abort, ATC measure: machine must be homed before tool measurement)
o105 endif

; ── 1. Validate tool number ───────────────────────────────────────────────────
(print, P394 entry: tool=#5400)
o100 if [#5400 EQ 0]
  (abort, ATC measure: no tool selected -- issue Tn M6 before measuring)
o100 endif

; ── 2. Check for existing offset — skip probe if already measured ─────────────
G65 P2 Q#5400 R2
(print, ATC: existing offset: _value=#<_value>)
o110 if [#<_value> NE 0]
  (print, ATC: tool #5400 already measured -- activating stored offset)
  G43 H#5400
o110 else

  ; ── 3. Cancel active TLO ───────────────────────────────────────────────────
  G49

  ; ── 4. Safe Z — machine home ───────────────────────────────────────────────
  G53 G0 Z0

  ; ── 5. XY to toolsetter centre ─────────────────────────────────────────────
  G53 G0 X#5381

  ; ── 6. Z to approach height ────────────────────────────────────────────────
  G53 G0 Z#5383

  ; ── 7. Fast seek — G38.3 (probe toward, no error on miss) ──────────────────
  G91
  G38.3 Z[-#4933] F#4935
  G90
  
  ; ── 8. Abort if toolsetter not triggered ───────────────────────────────────
  o120 if [#5070 NE 1]
    (abort, ATC measure: toolsetter not triggered on seek -- check #4933 and G59.3 Z)
  o120 endif

  ; ── 10. Slow locate probe — G38.4 (probe away, error if no loss of contact) ───
  G91
  G38.4 Z[#4933] F#4934
  G90
  G4P0

  ; ── 11. Store gauge length in tool table ───────────────────────────────────
  (print, ATC: probe Z=#5063 abs_z=#<_abs_z> G59.3_Z=#5383 tool=#5400)
  ;G10 L11 P#5400 Z[#<_abs_z> - #5383]
  G10 L1 P#5400 Z[#5063 - #5383]
  G65 P2 Q#5400 R2
  (print, ATC: post-G10 offset=#<_value>)

  ; ── 12. Activate tool length offset ────────────────────────────────────────
  G43 H#5400

  G65 P2 Q#5400 R2
  (print, ATC: tool #5400 measured -- offset Z#<_value> stored)

o110 endif

; ── 13. Retract to home Z ────────────────────────────────────────────────────
G53 G0 Z0

M99
