; tc.macro — Random-access tool change orchestrator for FlexiHAL ATC
;
; Called by grblHAL on M6 after tooltable.c has set the following parameters
; via onToolSelect:
;   #4900 = outgoing tool ID  (0 if spindle was empty)
;   #4901 = outgoing pocket   (-1 if hand-loaded or unknown after power cycle)
;   #4902 = incoming tool ID  (0 = T0, empty spindle)
;   #4903 = incoming pocket   (-1 if hand-loaded)
;   #4904 = 0 if called from a real Txx, 1 if called from M61
;
; Subroutines:
;   /P390.macro  — fetch carousel tool    (#4900=tool_id, #4901=pocket)
;   /P391.macro  — return carousel tool   (#4900=tool_id, #4901=pocket)
;   /P392.macro  — hand fetch             (M0 pause, operator installs tool)
;   /P393.macro  — hand return            (M0 pause, operator removes tool)
;   /P394.macro  — measure tool length    (skips if already measured, handles T0)
;
; Prerequisites:
;   - Machine homed
;   - Spindle and coolant off
;
; Note: macros.c fires tc.macro on M61 as well as M6. The o10 guard detects
; this case (#4902 EQ #4900 means parameters were not updated by onToolSelect)
; and skips the tool change body entirely.

(print, ATC: tool change tc.macro)

o10 if [#4904 EQ 1]
  (print, ATC: tc.macro called for M61 -- skipping)
o10 else

  (print, ATC: tool change T[#4900] -> T[#4902])
  (print, ATC: outgoing pocket=[#4901] incoming pocket=[#4903])

  ; ── Step 1: Return outgoing tool ───────────────────────────────────────────
  o100 if [#4900 NE 0]                        ; skip if spindle was empty
    o110 if [#4901 GE 1]                      ; outgoing tool came from carousel
      (print, ATC: returning T[#4900] to carousel pocket [#4901])
      G65 P391                                ; tcreturn — #4900=tool_id, #4901=pocket
    o110 else                                 ; outgoing tool was hand-loaded
      (print, ATC: remove hand-loaded T[#4900] and press cycle start)
      G65 P393                                ; handreturn — M0 pause
    o110 endif
  o100 endif

; ── Step 2: Fetch incoming tool ────────────────────────────────────────────
  o120 if [#4902 EQ 0]                        ; T0 — empty spindle requested
    (print, ATC: T0 requested -- spindle will be empty)
  o120 elseif [#4903 GE 1]                    ; incoming tool is in carousel
    (print, ATC: fetching T[#4902] from carousel pocket [#4903])
    #4900 = #4902                             ; set fetch parameters
    #4901 = #4903
    G65 P390                                  ; tcfetch — #4900=tool_id, #4901=pocket
  o120 else                                   ; incoming tool is hand-loaded
    (print, ATC: install T[#4902] manually and press cycle start)
    G65 P392                                  ; handfetch — M0 pause
  o120 endif

  ; ── Step 3: Update current tool ────────────────────────────────────────────
  ; M61 fires gc_tool_changed() which calls grbl.on_tool_changed,
  ; updating tooltable.c pocket assignments and last_fetched_pocket.
  (print, ATC: after P390 -- #4902=#4902 #4903=#4903)  
  #4904 = 1 ; set Txx flag before M61
  (print, ATC: about to M61 Q#4902)
  M61 Q#4902
  G4P0
  (print, ATC: after M61 -- #4902=#4902 #4903=#4903)
  
    ; ── Step 4: Measure incoming tool (skips T0 and already-measured tools) ───
  o125 if [#4902 NE 0]
    G65 P394
  o125 endif

  (print, ATC: tool change complete -- T[#4902] active)

o10 endif

M99
