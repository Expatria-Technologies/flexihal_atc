; This reads idle status coil from the PicoHAL with a 30 second timeout.  It then checks the alarm register.  Use after executing moves to ensure they completed successfully.
; --- Read coil 1 from device address 3, wait up to 30 seconds ---
; FC1 = read coils. S=device address, F=function code, R=register base address, X=count
; Coil 1 = register address 0 (zero-indexed), reading 1 coil

#<timeout_count> = 0          ; iteration counter
#<max_iterations> = 120        ; 120 iterations x 0.25 second dwell = 30 second timeout
#<timed_out> = 0              ; flag: 0 = success, 1 = timed out

;(print, P201: Starting idle coil poll - max_iterations=#<max_iterations>)

o100 do
    ;(print, P201: Poll attempt #<timeout_count> - calling G65 P7 S3 F1 R0 X1)
    G65 P7 S3 F1 R1 X1        ; Read 1 coil from device 3, address 0 (coil 1)
    ;(print, P201: FC1 response - _value_returned=#<_value_returned> _value=#<_value>)
    #<coil1> = #<_value>       ; store result
    ;(print, P201: coil1=#<coil1>)

    o110 if [#<_value_returned> GT 0 AND #<coil1> EQ 1]
        ;(print, P201: Coil 1 is 1 - idle confirmed, exiting loop)
        o100 break             ; coil is 1, exit the loop
    o110 endif

    #<timeout_count> = [#<timeout_count> + 1]
    ;(print, P201: Not idle yet - timeout_count=#<timeout_count> of #<max_iterations>)

    o120 if [#<timeout_count> GE #<max_iterations>]
        #<timed_out> = 1
        (print, Timeout waiting for coil 1 on device 3)
        o100 break
    o120 endif

    ;(print, P201: Dwelling)
    G4 P0.25                      ; dwell before retrying
o100 while [1]                 ; loop forever (exit via break)

;(print, P201: Coil poll complete - timeout_count=#<timeout_count> coil1=#<coil1> timed_out=#<timed_out>)

o140 if [#<timed_out> EQ 1]
    (ABORT, P201: Skipping alarm check due to timeout - system state unknown)
o140 endif

; --- Read register address 0 from device 3 and alarm if value is 1 ---
; FC3 = read holding registers. Adjust to FC4 if input registers.

;(print, P201: Checking alarm register - calling G65 P7 S3 F3 R0 X1)
G65 P7 S3 F1 R0 X1            ; Read 1 coil from device 3, address 0
;(print, P201: FC3 response - _value_returned=#<_value_returned> _value=#<_value>)
#<reg0> = #<_value>
;(print, P201: reg0=#<reg0>)

o130 if [#<_value_returned> GT 0 AND #<reg0> EQ 1]
    (ABORT, Alarm condition: register 0 = 1 on device 3)
o130 endif

(print, P201: Alarm check complete - reg0=#<reg0> no alarm raised)