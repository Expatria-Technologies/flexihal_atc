; ATC_MACRO_ID_TCFETCH 390 //fetch from tool carousel (OpenPnP four-positions style)
;
; Parameters:
;   #4900 = tool number
;   #4901 = carousel pocket number
;   #4906 = 0: open carousel, rotate, close (fetch only)
;           2: rotate only, close at end (fetch in a fetch+return pair — carousel already open)
;
; Geometry parameters — set once by G65 P200 in your startup macro:
;
;   #4920-#4922  Position 1: Safe XYZ
;   #4923-#4925  Position 2: Approach XYZ
;   #4926-#4928  Position 3: Engage XYZ
;   #4929-#4931  Position 4: Exit XYZ
;   #4932        Feed rate for all carousel positioning moves (mm/min)
;
; Load sequence:  P4 [open drawbar] → P3 [close drawbar] → P2 → P1


; ── Open carousel (fetch only — already open in fetch+return pair) ────────────
o100 if [#4906 EQ 0]
  G65 P201
  G65 P7 S3 F16 R1 A99
  G4 P0
o100 endif

; ── Move to safe position (P1) ───────────────────────────────────────────────
G53 G0 Z#4922
G53 G0 X#4920

; ── Carousel positioning — rotate to incoming pocket ─────────────────────────
; [ADD CAROUSEL ROTATION TO POCKET #4901 HERE]
G65 P201
G65 P7 S3 F16 R1 A[100 + #4901]
G65 P201

; ── Move to P4 ───────────────────────────────────────────────────────────────
G53 G1 X#4929 Z#4931 F#4932
G4 P0
$DRBO
G4 P0

; ── Descend to incoming pocket (P4 → P3) — clamp tool ───────────────────────
G53 G1 X#4926 Z#4928 F#4932
G4 P0
$DRBC
G4 P0

; ── Withdraw from pocket (P3 → P2 → P1) ─────────────────────────────────────
G53 G1 X#4923 Z#4925 F#4932
G53 G0 Z#4922
G53 G0 X#4920

; ── Close carousel ───────────────────────────────────────────────────────────
G4P0
G65 P7 S3 F16 R1 A98
G4 P0

M99
