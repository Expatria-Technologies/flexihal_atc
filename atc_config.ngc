; atc_config.ngc - ATC geometry configuration
;
; Run this once after homing to set carousel geometry parameters.
; Place a call to this file in your startup macro or run it manually.
;
; All coordinates are in machine coordinates (G53).

; ── Carousel geometry ─────────────────────────────────────────────────────────
#4910 = 50.0     ; X position of pocket 1
#4911 = 200.0    ; Y position of all pockets (fixed for linear carousel)
#4912 = 40.0     ; pocket pitch - X spacing between pockets (mm)
#4913 = -10.0    ; Z start height - just above pocket (machine coords)
#4914 = -45.0    ; Z engage height - tool fully seated in pocket (machine coords)
#4915 = 200.0    ; engage feed rate (mm/min)

; ── Manual tool change position ───────────────────────────────────────────────
#4916 = 0.0      ; X position for manual swap
#4917 = 0.0      ; Y position for manual swap

M2
